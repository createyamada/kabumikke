EDINET_API_KEY=your_edinet_api_key
EDINET_CACHE_DIR=.cache/edinet
EDINET_LOOKBACK_DAYS=180
# PostgreSQL example: postgresql://user:password@host:5432/database
# MySQL example: mysql+pymysql://user:password@host:3306/database?charset=utf8mb4
# SQLite example: sqlite:///data/kabumikke.db
DATABASE_URL=
DATABASE_RETRY_SECONDS=60
PRIME_RANKING_DIR=data/prime_ranking
PRIME_RANKING_WORKERS=3
PRIME_PROGRESS_WRITE_INTERVAL_SECONDS=1
# queued/runningの更新がこの秒数止まったら異常終了として解除する。
PRIME_RANKING_STALE_SECONDS=600
ANALYSIS_MODEL_CACHE_ENABLED=true
ANALYSIS_MODEL_CACHE_DIR=.cache/models
GLOBAL_MODEL_DIR=.cache/global_models
GLOBAL_MODEL_MAX_TRAINING_ROWS=250000
SITE_PASSWORD=replace_with_a_long_password
# Optional. If omitted, a signing key is derived from SITE_PASSWORD.
JWT_SECRET_KEY=replace_with_a_long_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=720
